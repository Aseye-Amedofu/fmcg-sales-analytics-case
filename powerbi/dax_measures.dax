// ===================== WAGCOL DEMO - DAX =====================
// Tables loaded from data/clean: fact_sales, fact_targets, fact_deliveries, dim_products, dim_customers, dim_reps
// plus outputs/p3_ashanti_safety_stock.csv (optional, for Problem 3)

// ---- Calendar table (Modeling > New table) ----
Calendar =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2026, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Month No", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "mmm yyyy" ),
    "Quarter", "Q" & QUARTER ( [Date] ) & " " & YEAR ( [Date] )
)
// Mark as date table: Table tools > Mark as date table > Date. Sort "Month" by "Month No" (or by a yyyymm column).

// ---- dim_region (Modeling > New table) ----
dim_region = DISTINCT ( SELECTCOLUMNS ( dim_customers, "region", dim_customers[region] ) )

// ---- Core sales measures ----
Revenue = SUM ( fact_sales[revenue] )
Units = SUM ( fact_sales[quantity] )
Gross Margin =
SUMX ( fact_sales, fact_sales[revenue] - fact_sales[quantity] * RELATED ( dim_products[unit_cost] ) )
Gross Margin % = DIVIDE ( [Gross Margin], [Revenue] )

// ---- Time intelligence (Problem 1) ----
Revenue PY = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
Revenue YoY % = DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )
Revenue Rolling 3M =
CALCULATE ( [Revenue], DATESINPERIOD ( 'Calendar'[Date], MAX ( 'Calendar'[Date] ), -3, MONTH ) )
H1 Growth Factor =
DIVIDE (
    CALCULATE ( [Revenue], ALL ( 'Calendar' ), DATESBETWEEN ( 'Calendar'[Date], DATE ( 2026, 1, 1 ), DATE ( 2026, 6, 30 ) ) ),
    CALCULATE ( [Revenue], ALL ( 'Calendar' ), DATESBETWEEN ( 'Calendar'[Date], DATE ( 2025, 1, 1 ), DATE ( 2025, 6, 30 ) ) )
)
Expected Revenue (trend) = [Revenue PY] * [H1 Growth Factor]
Revenue Gap vs Trend = [Revenue] - [Expected Revenue (trend)]

// ---- Supply measures (Problem 1 & 3) ----
Avg Lead Time (days) = AVERAGE ( fact_deliveries[lead_time_days] )
Avg Stockout Days = AVERAGE ( fact_deliveries[stockout_days] )
Fill Rate = DIVIDE ( SUM ( fact_deliveries[qty_delivered] ), SUM ( fact_deliveries[qty_ordered] ) )

// ---- Target measures (Problem 2) ----
Target = SUM ( fact_targets[target_amount] )
Attainment % = DIVIDE ( [Revenue], [Target] )
Attainment Status =
SWITCH (
    TRUE (),
    ISBLANK ( [Attainment %] ), BLANK (),
    [Attainment %] >= 1.1, "Star performer",
    [Attainment %] >= 0.9, "On track",
    "Below target"
)
Attainment Colour =
SWITCH ( TRUE (), [Attainment %] >= 1.1, "#27AE60", [Attainment %] >= 0.9, "#7F8C8D", "#C0392B" )   // use in Conditional formatting > Field value

// ---- Forecast (Problem 3) - meaningful for Oct-Dec 2026 ----
Forecast Revenue = [Revenue PY] * [H1 Growth Factor]
